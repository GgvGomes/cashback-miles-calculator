# Token da meta tag google-site-verification (Search Console > Propriedade > Tag HTML)
GOOGLE_SITE_VERIFICATION=

# URL pública (troque ao apontar domínio próprio). Sem barra no fim.
NEXT_PUBLIC_SITE_URL=https://cashback-miles-calculator.vercel.app

# Google AdSense — o script global e o ads.txt já saem com o publisher fixo em src/data/ads.ts;
# esta env só sobrescreve. Sem os slots abaixo nenhuma unidade é exibida.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Ids das unidades "Display responsivo" (AdSense > Anúncios > Por unidade de anúncio)
NEXT_PUBLIC_ADSENSE_SLOT_CONTEUDO=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_RODAPE=
# =1 desenha caixa tracejada no lugar de cada anúncio para validar layout local
NEXT_PUBLIC_ADS_PLACEHOLDER=
